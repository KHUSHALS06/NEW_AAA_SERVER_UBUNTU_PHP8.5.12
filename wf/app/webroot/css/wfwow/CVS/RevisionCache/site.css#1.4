ul.tabs{
    margin: 0px;
    padding: 0px;
    list-style: none;
}
ul.tabs li{
    background: #ededed;
    color: #222;
    display: inline-block;
    padding: 10px 15px;
    border-top:2px solid;
    border-left:2px solid;
    border-right:2px solid;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    cursor: pointer;
}

ul.tabs li.current{
    background: #D24932;
    color: #222;
}

.tab-content{
    display: none;
    background: #ededed;
    padding: 15px;
}

.tab-content.current{
    display: inherit;
}
