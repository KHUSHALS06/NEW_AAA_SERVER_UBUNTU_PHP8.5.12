        // Tooltip for edit action
        $('.actionEdit').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "Edit"
        });

        // Tooltip for view action
        $('.actionView').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "View"
        });

    });

</script>
