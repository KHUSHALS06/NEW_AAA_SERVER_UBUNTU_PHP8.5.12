<script type="text/javascript">
    // Initialize the editor
    tinymce.init({
        selector: "#content",
        height: '300px',
        theme: 'modern',
        document_base_url : "/HotSpotAdmin/app/webroot/LogoImages/",
        relative_urls : false,
        remove_script_host : false,
        convert_urls : false,
        schema: 'html5',
        plugins: [
            "advlist autolink link image lists charmap print preview hr anchor pagebreak",
            "searchreplace wordcount visualblocks visualchars fullscreen insertdatetime media nonbreaking",
            "save table contextmenu directionality emoticons template paste textcolor jbimages",
            "code"
        ],
        
        toolbar: "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | print preview fullpage | forecolor backcolor emoticons jbimages | code",

        //relative_urls: false,
        
        setup: function (editor) {
            editor.on('change', function () {
                tinymce.triggerSave();
            });
        },
        /*file_browser_callback : function(field_name, url, type, win){
            myFileBrowser(field_name, url, type, win);
        }*/
        file_browser_callback   : function(field_name, url, type, win) {
            var cmsURL = '/HotSpotAdmin/app/webroot/LogoImages';//window.location.toString();    // script URL - use an absolute path!
            //var cmsURL = '/HotSpotAdmin/C';
            //var cmsURL = window.location.toString();
            if (cmsURL.indexOf("?") < 0) {
                //add the type as the only query parameter
                cmsURL = cmsURL + "?type=" + type;
            }
            else {
                //add the type as an additional query parameter
                // (PHP session ID is now included if there is one at all)
                cmsURL = cmsURL + "&type=" + type;
            }

            tinyMCE.activeEditor.windowManager.open({
                file : cmsURL,
                title : 'My File Browser',
                width : 420,  // Your dimensions may differ - toy around with them!
                height : 400,
                resizable : "yes",
                inline : "yes",  // This parameter only has an effect if you use the inlinepopups plugin!
                close_previous : "no"
            }, 
            {
                window : win,
                input : field_name
            });
            return false;

        }
    });
</script>


