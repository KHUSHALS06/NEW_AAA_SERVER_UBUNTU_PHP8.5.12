<script type="text/javascript">

    $(document).ready(function() {
        $('#createuserForm').bootstrapValidator();
        $("#add_user_location_id[multiple] option").attr('selected', 'selected');
        $('#UserGroupId').change(function() {
            if (($("#add_user_location_id").has('option').length > 0) && (($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_noc') ?>') || ($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_engineer') ?>') || ($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_account') ?>'))) {
                //$("#add_user_location_id[multiple] option").attr('selected', 'selected');
                $("#add_user_location_id option").attr('selected', 'selected');
            } else if (($("#add_user_location_id").has('option').length == 0) && (($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_noc') ?>') || ($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_engineer') ?>'))) {
                alert('<?php echo Configure::read('Application.wf_noc') ?>');
                $("#locationsList").attr('style', 'display:none');
            } else {
                $("#locationsList").attr('style', 'display:block');
                $("#add_user_location_id option").removeAttr('selected', 'selected');
            }
        });

        $("#createuserForm").submit(function(e) {
            if (($("#add_user_location_id").has('option').length > 0) && (($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_noc') ?>') || ($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_engineer') ?>') || ($('#UserGroupId option:selected').text() == '<?php echo Configure::read('Application.wf_account') ?>'))) {
                $("#add_user_location_id[multiple] option").attr('selected', 'selected');
                //$("#add_user_location_id option").attr('selected', 'selected');
            } 
        });

        //$('#UserAddForm').bootstrapValidator();
        $('#UserAddForm').bootstrapValidator({
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {
                'data[Location][Location][]': {
                    validators: {
                        choice: {
                            min: 1,
                            //max: 4,
                            message: 'Please choose one or more locations'
                        }
                    }
                }
            }
        });
    });

</script>
