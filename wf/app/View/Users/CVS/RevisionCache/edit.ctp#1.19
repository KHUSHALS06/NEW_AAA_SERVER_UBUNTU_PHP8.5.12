<script type="text/javascript">

    $(document).ready(function() {

        $('#UserEditForm').bootstrapValidator();

        $('#remove').click(function() {
            return !$('#LocationLocation option:selected').remove().appendTo('#UserRemainingLocations');
        });

        $('#add').click(function() {
            return !$('#UserRemainingLocations option:selected').remove().appendTo('#LocationLocation');

        });

        $('#submitUserEditForm').click(function() {
            if ($('#LocationLocation option').length <= 0) {
                //if ($("#LocationLocation").val() == '') { alert('empty');
                $("#LocationLocation").attr('style', 'border-color: #953B39');
                $("#assignedLocationsErrorIcon").attr('style', 'display:inline');
                $("#assignedLocationsError").attr('style', 'display:inline;color:#B94A48');
                return false;
            } else {
                $("#LocationLocation option").attr('selected', 'selected');
                $("#LocationLocation").attr('style', '');
                $("#assignedLocationsErrorIcon").attr('style', 'display:none');
                $("#assignedLocationsError").attr('style', 'display:none');
                return true;
            }
        });

        /* $("#UserPassword").blur(function() {
         //alert("TextBox is Focused. The Div will Fade Out Now");
         if(document.getElementById('UserPassword').value > 0){
         //alert(document.getElementById('UserPassword').value)
         $('#confirmPwd').attr('style', 'display: block');
         } else {
         $('#confirmPwd').attr('style', 'display: none');
         }
         }); */

        $('#UserGroupId').change(function() {
            if (($("#LocationLocation").has('option').length > 0) && ($("#UserRemainingLocations").has('option').length > 0) && (($('#UserGroupId option:selected').text() == 'wf noc') || ($('#UserGroupId option:selected').text() == 'wf engineer'))) {
                $("#LocationLocation option").attr('selected', 'selected');
            } else if (($("#LocationLocation").has('option').length == 0) && ($("#UserRemainingLocations").has('option').length == 0) && (($('#UserGroupId option:selected').text() == 'wf noc') || ($('#UserGroupId option:selected').text() == 'wf engineer'))) {
                $("#locationsList").attr('style', 'display:none');
                //$("#remainingLocationsList").attr('style', 'display:none');
            } else {
                $("#locationsList").attr('style', 'display:block');
                //$("#remainingLocationsList").attr('style', 'display:block');
                //$("#locationsList").attr('style', 'display:block');
                $("#LocationLocation option").removeAttr('selected', 'selected');
            }

        });

    });

</script>
