<script type="text/javascript">
    $(document).ready(function() {
        $('.rateit').live('rated', function() {
            var ratingValue = $(this).rateit('value');
            var ratingId = $(this).attr('id');
            ratingId = ratingId.replace('_star', '');
            $('#' + ratingId).val(ratingValue);
        });
        $('.rateit').bind('reset', function() {
            var ratingId = $(this).attr('id');
            ratingId = ratingId.replace('_star', '');
            $('#' + ratingId).val('');
        });
    });
</script>
