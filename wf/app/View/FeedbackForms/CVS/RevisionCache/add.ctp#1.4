                $('#number_of_option').show();
                document.getElementById('element_options').innerHTML = '';
                for (var i = 0; i < $('#number_options').val(); i++) {
                    document.getElementById('element_options').innerHTML = document.getElementById('element_options').innerHTML + '<label for="FeedbackFormOption' + (i + 1) + '">Option' + (i + 1) + '</label><input name="data[FeedbackForm][options][' + i + ']" class="form-control" data-bv-notempty="1" data-bv-notempty-message="Username is required" data-bv-regexp="true" placeholder="Title" maxlength="255" id="FeedbackFormName" type="text">'
                }
            } else {
                $('#number_of_option').hide();
                document.getElementById('element_options').innerHTML = '';
            }
        });
        $('#number_options').change(function() {
            document.getElementById('element_options').innerHTML = '';
            for (var i = 0; i < $('#number_options').val(); i++) {
                document.getElementById('element_options').innerHTML = document.getElementById('element_options').innerHTML + '<label for="FeedbackFormOption' + (i + 1) + '">Option' + (i + 1) + '</label><input name="data[FeedbackForm][options][' + i + ']" class="form-control" data-bv-notempty="1" data-bv-notempty-message="Username is required" data-bv-regexp="true" placeholder="Title" maxlength="255" id="FeedbackFormName" type="text">'
            }
        });
    });

</script>
