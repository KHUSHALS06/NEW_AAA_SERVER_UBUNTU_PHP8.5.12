<script type="text/javascript">

    $(document).ready(function() {

        // Get the number of columns in a table and assign it to colspan attribute
        var numberOfColumns = document.getElementById('agentsTable').rows[0].cells.length;
        $("#emptyTableMessage").attr('colspan', numberOfColumns);

        // Tooltip for view action
        $('.actionView').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "View"
        });

        // Tooltip for edit action
        $('.actionEdit').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "Edit"
        });

        // Tooltip for assign location action
        $('.actionAssignLocation').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "Assign Location"
        });

        // Tooltip for activate action
        $('.actionActivate').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "Activate"
        });

        // Tooltip for deactivate action
        $('.actionDeactivate').tooltip({
            'show': true,
            'placement': 'bottom',
            'title': "Deactivate"
        });

    });

</script>

