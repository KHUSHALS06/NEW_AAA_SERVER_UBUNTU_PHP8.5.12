        // Revalidate the date when user changes it
        $('#from_date')
                .change(function(e) {
                    $('#CommissionChallanAddForm').bootstrapValidator('revalidateField', 'data[CommissionChallan][from]');
                });

        $('#to_date')
                .change(function(e) {
                    $('#CommissionChallanAddForm').bootstrapValidator('revalidateField', 'data[CommissionChallan][to]');
                });

        //$('#CommissionChallanAddForm').bootstrapValidator();

        // Check if agent is selected from agents list
        if (($('#CommissionChallanCommissionAgentId').val() == "") || ($('#CommissionChallanCommissionAgentId').val() == "0")) {
            $('#CommissionChallanLocationId').hide();
        } else {
            $('#CommissionChallanLocationId').show();
            if ($('#CommissionChallanLocationId option').length <= 1) {
                $("#CommissionChallanLocationId").attr('style', 'border-color: #953B39');
                $("#assignedLocationsErrorIcon").attr('style', 'display:inline');
                $("#assignedLocationsError").attr('style', 'display:inline;color:#B94A48');
                return false;
            } else {
                $("#CommissionChallanLocationId").attr('style', '');
                $("#assignedLocationsErrorIcon").attr('style', 'display:none');
                $("#assignedLocationsError").attr('style', 'display:none');
            }
        }

        // Validate the form with Bootstrap validator
        $('#CommissionChallanAddForm').bootstrapValidator({
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {
                'data[CommissionChallan][location_id]': {
                    validators: {
                        notEmpty: {
                            message: 'Please select a location'
                        }
                    }
                },
                'data[CommissionChallan][commission_agent_id]': {
                    validators: {
                        notEmpty: {
                            message: 'Please select agent'
                        }
                    }
                }

            }
        });
    });

</script>
