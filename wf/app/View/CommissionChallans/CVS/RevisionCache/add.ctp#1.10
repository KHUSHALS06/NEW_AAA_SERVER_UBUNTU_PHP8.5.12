<script type="text/javascript">
    $(function() {

        // Compare dates
        $('#submit_button').click(function() {
            var datepickerBegin = $("#from_date").datepicker("getDate")
            var datepickerEnd = $("#to_date").datepicker("getDate")
            var difference = (datepickerEnd - datepickerBegin) / (86400000 * 7);
            if (difference < 0) {
                $("#to_date").attr('style', 'border-color: #953B39');
                $("#toDateErrorIcon").attr('style', 'display:inline');
                $("#toDateError").attr('style', 'display:inline;color:#B94A48');
                return false;
            } else {
                $("#to_date").attr('style', '');
                $("#toDateErrorIcon").attr('style', 'display:none');
                $("#toDateError").attr('style', 'display:none');
            }
        });

    });
</script>

<script type="text/javascript">

    $(document).ready(function() {

        // JQuery datepicker for from date
        $('#from_date').datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '2007:' + (new Date).getFullYear(),
            showButtonPanel: true,
            //showOn: "button",
            //buttonImage: "../img/datepicker.png",
            //buttonImageOnly: true,
            dateFormat: 'dd-mm-yy',
            onClose: function(dateText, inst) {
                var month = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
                var year = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
                $(this).datepicker('setDate', new Date(year, month, 1));
                var datepickerBegin = $("#from_date").datepicker("getDate")
                var datepickerEnd = $("#to_date").datepicker("getDate")
                var difference = (datepickerEnd - datepickerBegin) / (86400000 * 7);
                if (difference < 0) {
                    $("#to_date").attr('style', 'border-color: #953B39');
                    $("#toDateErrorIcon").attr('style', 'display:inline');
                    $("#toDateError").attr('style', 'display:inline;color:#B94A48');
                    return false;
                } else {
                    $("#to_date").attr('style', '');
                    $("#toDateErrorIcon").attr('style', 'display:none');
                    $("#toDateError").attr('style', 'display:none');
                }
            }
        });

        // JQuery datepicker for to date
        $('#to_date').datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '2007:' + ((new Date).getFullYear() + 10),
            showButtonPanel: true,
            //showOn: "button",
            //buttonImage: "../img/datepicker.png",
            //buttonImageOnly: true,
            dateFormat: 'dd-mm-yy',
            onClose: function(dateText, inst) {
                var month = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
                var year = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
                var lastDay = new Date(year, month, 1).getDaysInMonth();
                $(this).datepicker('setDate', new Date(year, month, lastDay));
                var datepickerBegin = $("#from_date").datepicker("getDate")
                var datepickerEnd = $("#to_date").datepicker("getDate")
                var difference = (datepickerEnd - datepickerBegin) / (86400000 * 7);
                if (difference < 0) {
                    $("#to_date").attr('style', 'border-color: #953B39');
                    $("#toDateErrorIcon").attr('style', 'display:inline');
                    $("#toDateError").attr('style', 'display:inline;color:#B94A48');
                    return false;
                } else {
                    $("#to_date").attr('style', '');
                    $("#toDateErrorIcon").attr('style', 'display:none');
                    $("#toDateError").attr('style', 'display:none');
                }
            }
        });

