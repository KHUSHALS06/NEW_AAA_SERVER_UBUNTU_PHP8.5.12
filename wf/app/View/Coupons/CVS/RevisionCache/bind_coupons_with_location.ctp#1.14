<script type="text/javascript">
    $(function() {
        var addDiv = $('#addNewRow');
        var i = $('#addNewRow #couponRange').size();
        optionString = $('#optionList').text().split('###');
        var optionStringValue = [];
        //alert(optionString.length);
        //alert(i)
        for (k = 0; k < optionString.length; k = k + 1) {
            optionStringValue[k] = optionString[k].split('~~~');
            //optionStringValue[k] = optionString[k].split('~~~')[1];
            //alert(optionStringValue[k]); 
        }
        $('.clickToAddMore').live('click', function() { //alert();
            //var optionString = $('#optionList').text();
            stringToPrint = '<div class="row col-lg-12 col-md-12"><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponBillingPlanId">Billing Plan</label><select name="data[Coupon][billing_plan_id_' + i + ']" class="form-control" placeholder="Billing Plan" id="CouponBillingPlanId' + i + '">';
            for (j = 0; j < optionString.length; j = j + 1) {
                stringToPrint = stringToPrint + '<option value=' + optionString[j].split('~~~')[0] + '>' + optionString[j].split('~~~')[1] + '(Rs.' + optionString[j].split('~~~')[2] + '/-)</option>';
            }
            stringToPrint = stringToPrint + '</select></div></div><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponSerialFrom">From</label><input name="data[Coupon][serialFrom_' + i + ']" class="form-control serialFrom" placeholder="From" type="text" id="CouponSerialFrom_' + i + '"/></div><span id="error" style="display:none;"><i class="fa fa-times"></i>FROM should be less than TO</span><i id="serialFromErrorIcon_' + i + '" data-bv-icon-for="data[Coupon][serialFrom_' + i + ']" class="form-control-feedback glyphicon glyphicon-remove" style="display:none"></i><small id ="serialFromError_' + i + '" data-bv-result="VALID" data-bv-for="data[User][email]" data-bv-validator="notEmpty" class="help-block" style="display: none">FROM should be less than TO</small></div><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponSerialTo">To</label><input name="data[Coupon][serialTo_' + i + ']" class="form-control serialTo" autocomplete="off" data-bv-regexp-message="Name can only consist of alphabets" placeholder="To" type="text" id="CouponSerialTo_' + i + '"/></div></div></div>';
            //$('<div class="row col-lg-12 col-md-12"><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponBillingPlanId">Billing Plan</label><select name="data[Coupon][billing_plan_id_'+i+']" class="form-control" placeholder="Billing Plan" id="CouponBillingPlanId'+i+'">'+optionString+'</select></div></div><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponSerialFrom">From</label><input name="data[Coupon][serialFrom_'+i+']" class="form-control" autocomplete="off" data-bv-regexp-message="Username can only consist of alphabets and numbers, with no blank space" placeholder="From" type="text" id="CouponSerialFrom'+i+'"/></div></div><div class="col-lg-3 col-md-3"><div class="form-group"><label for="CouponSerialTo">To</label><input name="data[Coupon][serialTo_'+i+']" class="form-control" autocomplete="off" data-bv-regexp-message="Name can only consist of alphabets" placeholder="To" type="text" id="CouponSerialTo'+i+'"/></div></div><div class="col-lg-3 col-md-3 "><br><br><a href="#" class="clickToAddMore">Click to add more</a></div></div>').appendTo(addDiv);
            $('' + stringToPrint).appendTo(addDiv);
            // <input type="text" id="p_new" size="40" name="p_new_' + i +'" value="" placeholder="I am New" /><a href="#" id="remNew">Remove</a> </p>').appendTo(addDiv);
            i++;
            return false;
        });

        $('.serialTo').live('blur', function(e) {
            var toid = e.target.id;
            var substring = toid.split('_')[1];
            
            if ($('#CouponSerialFrom_'+substring).val()> $('#CouponSerialTo_'+substring).val()) {
                //alert('error');
                $('#CouponSerialFrom_' + substring).attr('style', 'border-color: #953B39');
                $("#serialFromErrorIcon_" + substring).attr('style', 'display:inline');
                $("#serialFromError_" + substring).attr('style', 'display:inline;color:#B94A48');
                $('#submitCoupon').attr('disabled','disabled');
                return false;
            } else {
                $('#CouponSerialFrom_' + substring).attr('style', '');
                $("#serialFromErrorIcon_" + substring).attr('style', 'display:none');
                $("#serialFromError_" + substring).attr('style', 'display:none');
                $('#submitCoupon').removeAttr('disabled');
            }
        });

        $('.serialFrom').live('blur', function(e) {
            var fromid = e.target.id;
            var substring = fromid.split('_')[1];
            //alert(fromid)
            if($('#CouponSerialTo_'+substring).val()!=""){
                if ($('#CouponSerialFrom_'+substring).val() > $('#CouponSerialTo_'+substring).val()) {
                    //alert('error');
                    $('#CouponSerialFrom_'+substring).attr('style', 'border-color: #953B39');
                    $("#serialFromErrorIcon_"+substring).attr('style', 'display:inline');
                    $("#serialFromError_"+substring).attr('style', 'display:inline;color:#B94A48');
                    $('#submitCoupon').attr('disabled','disabled');
                    return false;
                } else {
                    $('#CouponSerialFrom_'+substring).attr('style', '');
                    $("#serialFromErrorIcon_"+substring).attr('style', 'display:none');
                    $("#serialFromError_"+substring).attr('style', 'display:none');
                    $('#submitCoupon').removeAttr('disabled');
                } 
            }
        });




    });

</script>
