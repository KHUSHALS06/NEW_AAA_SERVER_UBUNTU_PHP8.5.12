<script>
    $(function() {
        var newURL = window.location.protocol + "//" + window.location.host + "" + window.location.pathname;
        $.fn.editable.defaults.mode = 'inline';
        /*$('.editLocationName').editable({
         url: newURL+'/updateLocationName',
         validate: function(value) {
         if ($.trim(value) == '') {
         return 'This field is required';
         }
         if (!(/^[a-zA-Z\s]*$/.test(value))) {
         return 'Only alphabets allowed';
         }
         }
         });*/
        $('.editContactPersonName').editable({
            url: newURL + '/updateContactPersonName',
            validate: function(value) {
                if ($.trim(value) == '') {
                    return 'This field is required';
                }
                if (!(/^[a-zA-Z\s]*$/.test(value))) {
                    return 'Only alphabets allowed';
                }
            }
        });
        $('.editInstalationState').editable({
            url: newURL + '/updateInstalationState',
            validate: function(value) {
                if ($.trim(value) == '') {
                    return 'This field is required';
                }
                if (!(/^[a-zA-Z\s]*$/.test(value))) {
                    return 'Only alphabets allowed';
                }
//                if ($.trim(value) == '') {
//                    return 'This field is required';
//                }
//                if (!(/^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/.test(value))) {
//                    return 'Invalid email address';
//                }
            }
        });
        $('.editContactPersonPost').editable({
            url: newURL + '/updateContactPersonPost',
            validate: function(value) {
                if ($.trim(value) == '') {
                    return 'This field is required';
                }
                if (!(/^[a-zA-Z\s]*$/.test(value))) {
                    return 'Only alphabets allowed';
                }
            }
        });
    });
</script>

