            dateFormat: 'dd-mm-yy',
            showButtonPanel: true,
            changeMonth: true,
            changeYear: true
                    //showOn: "button",
                    //buttonImage: "../img/datepicker.png",
                    //buttonImageOnly: true
        });

        // Revalidate the date when user changes it
        /*
