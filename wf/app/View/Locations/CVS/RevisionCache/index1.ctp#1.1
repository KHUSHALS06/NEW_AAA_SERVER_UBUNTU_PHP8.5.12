            fields: {
                username: {
                    validators: {
                        notEmpty: {
                            message: 'The username is required'
                        },
                        stringLength: {
                            min: 6,
                            max: 20,
                            message: 'The username should be between 6 to 20 characters' 
                        }
                    }
                },
                name: {
                    validators: {
                        notEmpty: {
                            message: 'The name is required'
                        },
                        stringLength: {
                            min: 6,
                            max: 20,
                            message: 'The name should be between 6 to 20 characters' 
                        }
                    }
                },
                email: {
                    validators: {
                        notEmpty: {
                            message: 'The email cannot be empty'
                        },
                        emailAddress:{
                            message: 'The email is not valid'
                        }
                    }
                },
                password: {
                    validators: {
                        notEmpty: {
                            message: 'The password is required'
                        }
                    }
                }
            }
        })
        

        $('#AddUserModal').on('shown.bs.modal', function() {
            $('#UserAddForm').bootstrapValidator('resetForm', true);
        });
    });
   
</script>

