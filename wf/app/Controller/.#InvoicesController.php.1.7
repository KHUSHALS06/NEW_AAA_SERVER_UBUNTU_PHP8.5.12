<?php

App::uses('AppController', 'Controller');

class InvoicesController extends AppController {

    public $uses = array('Invoice', 'Location', 'InvoiceTrack', 'InvoiceExtra', 'Cheque');

    /**
     * Helpers
     *
     * @var array
     */
    public $helpers = array('Js');

    /**
     * Components
     *
     * @var array
     */
    public $components = array('Paginator', 'RequestHandler');

    function beforeFilter() {
        parent::beforeFilter();
    }

    public function index() {
        $this->redirect(array('action'=>'individual_payment'));
    }

    public function overall_payment() {
        $condition = array();
        if (isset($this->request->data['invoices']['invoice_period']) && ($this->request->data['invoices']['invoice_period']!='')) {
            $condition[] = array(
                'month' => date("n", strtotime($this->request->data['invoices']['invoice_period'])),
                'year' => date("Y", strtotime($this->request->data['invoices']['invoice_period']))
            );
        } else {
            $condition[] = array(
                'month' => date("n", strtotime("-1 month")),
                'year' => date("Y", strtotime("-1 month"))
            );
        }

        $this->Paginator->settings = array(
            'limit' => 10,
            'order' => array('Invoice.id' => 'ASC'),
            'conditions' => $condition,
        );

        $this->set('overallPaymentDatas', $this->Paginator->paginate('InvoiceTrack'));
        $this->set('breadcrumbLabel', 'Overall Payment');
        $this->Session->write('link', 'overallPayment');
    }

    public function individual_payment() {
        if ($this->request->is('POST') && isset($this->request->data['invoices']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['invoices']['locations_id']);
        }
        $this->Invoice->bindModel(array('hasOne' => array('InvoiceTrack')), false);
        $this->Paginator->settings = array(
            'limit' => 10,
            'order' => array('Invoice.id' => 'ASC'),
            'conditions' => array(
                'Invoice.location_id' => $this->Session->read('choosed_location_id'),
            ),
            'contain' => 'InvoiceTrack'
        );
        $this->Invoice->bindModel(array('hasOne' => array('InvoiceTrack')), false);
        $this->set('individualPaymentDatas', $this->Paginator->paginate('Invoice'));
        $this->set('breadcrumbLabel', 'Individual Payment');
        $this->Session->write('link', 'individualPayment');
    }

    public function displayInstrument($instNumAndDesc) {
        $splitInstrumentNumberAndDescription = explode('#', $instNumAndDesc);
        $instrument = $this->Cheque->find('first', array(
            'conditions' => array('Cheque.instrument_number' => $splitInstrumentNumberAndDescription[0]),
            'recursive' => -1
                ));

        if ($instrument['Cheque']['scan'] == '') {
            $this->Session->setFlash(__('No scanned copy uploaded for this instrument'), 'flash_info');
            $this->redirect(array('action' => 'individual_payment'));
        } else {

            $file = $instrument['Cheque']['scan'];
            $size = $instrument['Cheque']['scan_size'];
            $type = $instrument['Cheque']['scan_type'];
            $name = $instrument['Cheque']['scan_name'];
            ob_clean();
            header("Content-Length: $size");
            header("Content-Type: $type");
            header("Content-Disposition:attachment;filename=$name");
            echo $file;
        }
    }

    public function printInvoice($id) {
        $this->Invoice->recursive = -1;
        $challan = $this->Invoice->findById($id);
        $file = $challan['Invoice']['invoices'];
        $size = $challan['Invoice']['size'];
        $type = $challan['Invoice']['type'];
        $name = $challan['Invoice']['invoice_name'];
        ob_clean();
        header("Content-Length: $size");
        header("Content-Type: $type");
        header("Content-Disposition:attachment;filename=$name");
        echo $file;
    }

}
?>