    public function update_header_title(){
        if ($this->request->is('post')) {
            $data = $this->request->data;
            # Set User model for edit
            $this->FeedbackHeader->read(null, $data['pk']);
            if ($this->FeedbackHeader->validates(array('title' => array('title')))) {
                if ($this->FeedbackHeader->saveField($data['name'], $data['value'])) {
                    # Set the username and echo it in update_username.ctp
                    $this->FeedbackHeader->set($data['name'], $data['value']);
                    $this->log("Feedback Header Title updated", 'info');
                }
            } else {
                $errors = $this->FeedbackHeader->validationErrors;
            }
        }
    }
