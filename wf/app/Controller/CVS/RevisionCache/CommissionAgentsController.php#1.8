<?php

App::uses('AppController', 'Controller');

class CommissionAgentsController extends AppController {

    public $helpers = array('Js'); //var $helpers = array('Js','Csv', 'xls', 'PhpExcel');
    public $components = array('Paginator', 'RequestHandler');
    public $uses = array('CommissionAgentsLocation', 'CommissionAgent', 'Location');

    /**
     * This is the default method for the CommissionAgents controller.
     * If a particular location is set then it fetches the commission agents associated to that particular location.
     * 
     * @return void
     */
    public function index() {
        $condition = array();
        $this->CommissionAgent->bindModel(array('hasMany' => array('CommissionAgentsLocation')), false);
        if ($this->request->is('POST') && isset($this->request->data['commission_agents']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['commission_agents']['locations_id']);
        }
        if ($this->Session->check('choosed_location_id') && $this->Session->read('choosed_location_id') != '') {
            $condition[] = array('CommissionAgentsLocation.location_id' => $this->Session->read('choosed_location_id'));
        } else {
            $condition[] = array('CommissionAgentsLocation.location_id' => '');
        }

        $this->Paginator->settings = array(
            'limit' => 10,
            //'fields' => array('Location.id', 'DISTINCT Location.id' ),
            'order' => array('CommissionAgent.first_name' => 'ASC'),
                //'conditions' => array('CommissionAgentsLocation.location_id' => '172'),
        );
        $this->set('label', 'Commission Agents');
        $this->set('breadcrumbLabel', 'Commission Agents');
        $this->Session->write('link', 'commissionAgentsList');
        $this->set('commissionAgents', $this->Paginator->paginate('CommissionAgent'));
    }

    /**
     * Add the commission agent details
     * 
     * @return void
     */
    public function add() {
        if ($this->request->is('POST')) {
            $this->CommissionAgent->create();
            if ($this->CommissionAgent->saveAll($this->request->data)) {
                $this->log("Commission agent added", 'info');
                $this->Session->setFlash(__('Commission agent added successfully'), 'flash_success');
                $this->redirect(array('action' => 'index'));
            }
        }
        $this->set('breadcrumbLabel', 'Add Commission Agent');
    }

    /**
     * Assign location to commission agent
     * 
     * @return void
     */
    public function assign_location() {
        if ($this->request->is('post')) {
            if (isset($this->request->data['CommissionAgent']) && $this->request->data['CommissionAgent']['id'] != '') {
                $this->set('commission_agent_id', $this->request->data['CommissionAgent']['id']);
                $commissionAgent = $this->CommissionAgent->find('first', array(
                    'fields' => array('CommissionAgent.first_name', 'CommissionAgent.last_name'),
                    'conditions' => array('CommissionAgent.id' => $this->request->data['CommissionAgent']['id'])
                        ));
                $this->set('agent_first_name', $commissionAgent['CommissionAgent']['first_name']);
                $this->set('agent_last_name', $commissionAgent['CommissionAgent']['last_name']);
            }
            if (isset($this->request->data['CommissionAgentsLocation']) && count($this->request->data['CommissionAgentsLocation']) > 0) {
                $this->CommissionAgentsLocation->create();
                if ($this->CommissionAgentsLocation->save($this->request->data)) {
                    $this->log("Location ID: " . $this->request->data['CommissionAgentsLocation']['location_id'] . " assigned to agent " . $this->request->data['CommissionAgentsLocation']['commission_agent_id'] . " added", 'info');
                    $this->Session->setFlash(__('Location assigned successfully'), 'flash_success');
                    $this->redirect(array('action' => 'index'));
                }
                $this->set('commission_agent_id', '');
            }
        } else {
            $this->redirect(array('action' => 'index'));
        }

        $this->set('locations', $this->Session->read('locations_list'));
        $commission_on = $this->enumToSelectField('CommissionAgentsLocation', 'commission_agents_locations', 'commission_on');
        $this->set('commission_on', $commission_on);
        $this->set('breadcrumbLabel', 'Assign Agent Loaction');
    }

    /**
     * View commission agent details
     * 
     * @return void
     */
    public function view() {
        $this->set('label', 'View Commission Agent');
        $this->set('breadcrumbLabel', 'View Commission Agent');
        if ($this->request->is('POST') && count($this->request->data) > 0) {

            $commissionAgentsData = $this->CommissionAgent->findById($this->request->data['CommissionAgent']['id']);
            $this->set('commissionAgentsData', $commissionAgentsData);
        } else {
            $this->redirect(array('action' => 'index'));
        }
    }

    /**
     * Edit commission agent details
     * 
     * @return void
     */
    public function edit() {
        $this->set('label', 'Edit Commission Agent');
        $this->set('breadcrumbLabel', 'Edit Commission Agent');
        $this->Session->write('link', 'editGuest');
        if ($this->request->is('post')) {
            if (count($this->request->data['CommissionAgent']) > 1) {
                if ($this->CommissionAgent->save($this->request->data)) {
                    $this->log("Commission Agent: " . $this->request->data['CommissionAgent']['first_name'] . " " . $this->request->data['CommissionAgent']['last_name'] . " updated by User ID: " . AuthComponent::user('id'), 'info');
                    $this->Session->setFlash(__('Commission Agent: <strong>' . $this->request->data['CommissionAgent']['first_name'] . " " . $this->request->data['CommissionAgent']['last_name'] . '</strong> updated successfully'), 'flash_success');
                    return $this->redirect(array('action' => 'index'));
                } else {
                    $this->Session->setFlash(__('The commission agent details could not be saved. Please, try again.'));
                }
                $commissionAgentsData = $this->CommissionAgent->findById($this->request->data['CommissionAgent']['id']);
                $this->set('commissionAgentsData', $commissionAgentsData);
            } else {
                $commissionAgentsData = $this->CommissionAgent->findById($this->request->data['CommissionAgent']['id']);
                $this->set('commissionAgentsData', $commissionAgentsData);
            }
        } else {
            return $this->redirect(array('action' => 'index'));
        }
    }

    /**
     * Deactivate the commission agent
     * 
     * @return void
     */
    public function deactivate() {
        if ($this->request->is('post')) {
            if ($this->request->data['CommissionAgent']['id'] != '') {
                $this->CommissionAgent->id = $this->request->data['CommissionAgent']['id'];
                if ($this->CommissionAgent->exists()) {
                    if ($this->CommissionAgent->saveField('status', 'inactive')) {
                        $this->log("Agent deactivated", 'info');

                        $this->Session->setFlash(__('Agent ' . $this->request->data['CommissionAgent']['first_name'] . ' is de-activated'), 'flash_success');
                        $this->redirect(array('action' => 'index'));
                    } else {
                        $this->Session->setFlash(__('Unable to de-activate'), 'flash_fail');
                        $this->redirect(array('action' => 'index'));
                    }
                } else {
                    $this->Session->setFlash(__('Invalid user id provided'), 'flash_fail');
                    $this->redirect(array('action' => 'index'));
                }
            } else {
                $this->Session->setFlash(__('Please provide a user id.'), 'flash_fail');
            }
        }
    }

    /**
     * Activate the commission agent
     * 
     * @return void
     */
    public function activate() {

        if ($this->request->is('post')) {
            if ($this->request->data['CommissionAgent']['id'] != '') {
                $this->CommissionAgent->id = $this->request->data['CommissionAgent']['id'];
                if ($this->CommissionAgent->exists()) {
                    if ($this->CommissionAgent->saveField('status', 'active')) {
                        $this->log("Agent activated", 'info');
                        $this->Session->setFlash(__('Agent ' . $this->request->data['CommissionAgent']['first_name'] . ' is activated'), 'flash_success');
                        $this->redirect(array('action' => 'index'));
                    } else {
                        $this->Session->setFlash(__('Unable to activate'), 'flash_fail');
                        $this->redirect(array('action' => 'index'));
                    }
                } else {
                    $this->Session->setFlash(__('Invalid user id provided'), 'flash_fail');
                    $this->redirect(array('action' => 'index'));
                }
            } else {
                $this->Session->setFlash(__('Please provide a user id.'), 'flash_fail');
            }
        }
    }

    /**
     * Inline edit the city of the agent
     *
     * @return void
     */
    public function update_city() {
        if ($this->request->is('post')) {
            $data = $this->request->data;
            $this->CommissionAgent->read(null, $data['pk']);
            $this->CommissionAgent->set($data['name'], $data['value']);
            if ($this->CommissionAgent->validates(array('fieldList' => array('city')))) {
                if ($this->CommissionAgent->saveField($data['name'], $data['value'])) {
                    $this->CommissionAgent->set($data['name'], $data['value']);
                    $this->log("Commission agent city updated", 'info');
                }
            } else {
                // didn't validate logic
            }
        }
    }

