    public function imageBrowser() {
        if (!$this->Acl->check(AuthComponent::user('Group.name'), $this->request->params['action']))
            $this->redirect(array('controller' => 'permission_errors', 'action' => 'unauthorized'));
        
        $dir = '../webroot/LogoImages';
        $file_display = array('jpg', 'jpeg', 'png', 'gif');

        if (file_exists($dir) == false) {
            echo 'Directory "', $dir, '" not found!';
        } else {
            //var_dump($dir);
            $dir_contents = scandir($dir);
            //var_dump($dir_contents);
            $filePath = array();
            $i = 0;
            foreach ($dir_contents as $file) {
                $x = explode('.', $file);
                $x = end($x);
                $file_type = strtolower($x);
                $displayString = '';


                if ($file !== '.' && $file !== '..' && in_array($file_type, $file_display) == true) {
                    $name = basename($file);
                    ////pr($dir.'.'.$name);
                    $filePath[$i] = $dir . '/' . $name;
                    $i++;
                    ////pr("<img class='thumnelImage' height='100px' width='100px' src='img.php?name={$name}' />");
                    //$displayString = $displayString. "<img class='thumnelImage' height='100px' width='100px' src='img.php?name={$name}' />";
                }
            }
            $this->set('filePaths', $filePath);
        }
        ////pr($dir_contents);
    }

    public function uploadBackgroundImage($id = null) {
        if (!$this->Acl->check(AuthComponent::user('Group.name'), $this->request->params['action']))
            $this->redirect(array('controller' => 'permission_errors', 'action' => 'unauthorized'));
        
        ////pr($this->request->data);
        if ($this->request->is('post')) {
            $fileArray = explode(".", $this->request->data['CmsLoginpage']['backgroundImage']['name']);
            ////pr($fileArray[count($fileArray) - 1]);

            $filepath = 'Background/bg_' . $this->Session->read('choosed_location_id') . '.' . $fileArray[count($fileArray) - 1];
            str_replace('\\', '/', $filepath);
            $isCMSset = $this->CmsLoginpage->find('all', array(
                'fields' => array('id', 'location_id'),
                'conditions' => array('location_id' => $this->Session->read('choosed_location_id'))
            ));
            if (count($isCMSset) > 0 && $isCMSset != '') {
                if ($this->CmsLoginpage->updateAll(array('CmsLoginpage.background' => '\'/app/webroot/' . $filepath . '\''), array('CmsLoginpage.location_id' => $this->Session->read('choosed_location_id')))) {
                    move_uploaded_file($this->data['CmsLoginpage']['backgroundImage']['tmp_name'], $filepath);
                    $this->Session->setFlash('Background successfully upladed. Refresh the page to see the effect', 'flash_success');
                    $this->redirect(array('action' => 'index'));
                } else {
                    $this->Session->setFlash('Problem with file uploading', 'flash_fail');
                }
            } else {
                $data = array();
                $data['CmsLoginpage']['location_id'] = $this->Session->read('choosed_location_id');
                $data['CmsLoginpage']['background'] = '\'' . $filepath . '\'';
                if ($this->CmsLoginpage->save($data)) {
                    move_uploaded_file($this->data['CmsLoginpage']['backgroundImage']['tmp_name'], $filepath);
                    $this->Session->setFlash('Background successfully upladed. Refresh the page to see the effect', 'flash_success');
                    $this->redirect(array('action' => 'index'));
                } else {
                    $this->Session->setFlash('Cannot register a user' . 'flash_fail');
                }
            }

            /*
              $this->data['User']['doc_file'] = WWW_ROOT . DS .'bg_'.$this->Session->read('choosed_location_id');
              if ($this->User->save($this->request->data)) {
              move_uploaded_file($this->data['User']['new_doc_file']['tmp_name'], $this->data['User']['doc_file']);

