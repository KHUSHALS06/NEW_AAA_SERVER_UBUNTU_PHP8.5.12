    /**
     * This is the default method for the CmsLoginpages controller, redirecting to the edit page.
     * 
     * @return void
     */
    public function index() {
        if (!$this->Acl->check(AuthComponent::user('Group.name'), $this->request->params['action']))
            $this->redirect(array('controller' => 'permission_errors', 'action' => 'unauthorized'));
        
        $this->redirect(array('action' => 'edit'));
    }

    /**
     * This method fetches the login CMS contents.
     * If a particular location is set then it fetches the login CMS contents associated to that particular location.
     * 
     * @return void
     */
    public function edit() {
        if (!$this->Acl->check(AuthComponent::user('Group.name'), $this->request->params['action']))
            $this->redirect(array('controller' => 'permission_errors', 'action' => 'unauthorized'));
        
        if ($this->request->is('post') && isset($this->request->data['cms_loginpages']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['cms_loginpages']['locations_id']);
            if ($this->request->data['cms_loginpages']['locations_id'] == '') {
                $this->Session->setFlash(__('Please select a location first'), 'flash_info');
                $this->set('emptyLocation', 'true');
            } else {
                $this->set('emptyLocation', 'false');
            }
        }
        if ($this->Session->read('choosed_location_id') == '') {
            $this->Session->setFlash(__('Please select a location first'), 'flash_info');
            $this->set('emptyLocation', 'true');
        } else {
            $this->set('emptyLocation', 'false');
        }
        $condition = array();
        if ($this->request->is('POST') && isset($this->request->data['cms_loginpages']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['cms_loginpages']['locations_id']);
            //$tempLocationsDomainListArray = $this->Session->read('locations_domain_list');
            //$this->set('locationDomain', $tempLocationsDomainListArray[$this->Session->read('choosed_location_id')]);
            $condition[] = array(
                'CmsLoginpage.location_id' => $this->request->data['cms_loginpages']['locations_id'],
                    //'CmsLoginpage.location_domain' => $tempLocationsDomainListArray[$this->Session->read('choosed_location_id')]
            );
        }
        if ($this->Session->check('choosed_location_id') && $this->Session->read('choosed_location_id') != '') {
            $condition[] = array('CmsLoginpage.location_id' => $this->Session->read('choosed_location_id'));
        }

        if (count($condition) > 0) {
            $content = $this->CmsLoginpage->find('first', array(
                'fields' => array('CmsLoginpage.location_id', 'CmsLoginpage.header', 'CmsLoginpage.tariff', 'CmsLoginpage.footer', 'CmsLoginpage.advertisement', 'CmsLoginpage.background'),
                'conditions' => $condition
                    )
            );
            if (count($content) == 0) {
                $this->set('header', '');
                $this->set('tariff', '');
                $this->set('footer', '');
                $this->set('advertisement', '');
                //$this->set('emptyLocation', 'true');
                $billingPlans = $this->BillingPlan->find('all', array(
                    'fields' => array('name_bp', 'price_bp'),
                    'conditions' => array('location_id' => $this->Session->read('choosed_location_id'), 'cat_bp' => 'normal')
                ));
                if ($billingPlans != '') {
                    $tariffString = '';
                    $tariffString = $tariffString . '<table class="table table-bordered table-striped">';
                    $tariffString = $tariffString . '<tr>';
                    $tariffString = $tariffString . '<th>';
                    $tariffString = $tariffString . 'PLAN NAME';
                    $tariffString = $tariffString . '</th>';
                    $tariffString = $tariffString . '<th>';
                    $tariffString = $tariffString . 'PRICE';
                    $tariffString = $tariffString . '</th>';
                    $tariffString = $tariffString . '</tr>';
                    foreach ($billingPlans as $value) {
                        $tariffString = $tariffString . '<tr>';
                        $tariffString = $tariffString . '<td>';
                        $tariffString = $tariffString . $value['BillingPlan']['name_bp'];
                        $tariffString = $tariffString . '</td>';
                        $tariffString = $tariffString . '<td>';
                        $tariffString = $tariffString . $value['BillingPlan']['price_bp'];
                        $tariffString = $tariffString . '</td>';
                        $tariffString = $tariffString . '</tr>';
                    }
                    $tariffString = $tariffString . '</table>';
                    $content['CmsLoginpage']['tariff'] = $tariffString;
                    $this->set('tariff', $content['CmsLoginpage']['tariff']);
                }
                //pr($billingPlans);
            } else {
                //pr($content);
                if ($content['CmsLoginpage']['header'] == '') {
                    $this->set('header', '');
                } else {
                    $this->set('header', $content['CmsLoginpage']['header']);
                }
//                $content['CmsLoginpage']['tariff'];
                if ($content['CmsLoginpage']['tariff'] == '') {
                    $billingPlans = $this->BillingPlan->find('all', array(
                        'fields' => array('name_bp', 'price_bp'),
                        'conditions' => array('location_id' => $this->Session->read('choosed_location_id'), 'cat_bp' => 'normal')
                    ));
//                    pr($billingPlans);
                    if ($billingPlans != '') {
                        $tariffString = '';
                        $tariffString = $tariffString . '<table class="table table-bordered table-striped">';
                        $tariffString = $tariffString . '<tr>';
                        $tariffString = $tariffString . '<th>';
                        $tariffString = $tariffString . 'PLAN NAME';
                        $tariffString = $tariffString . '</th>';
                        $tariffString = $tariffString . '<th>';
                        $tariffString = $tariffString . 'PRICE';
                        $tariffString = $tariffString . '</th>';
                        $tariffString = $tariffString . '</tr>';
                        foreach ($billingPlans as $value) {
                            $tariffString = $tariffString . '<tr>';
                            $tariffString = $tariffString . '<td>';
                            $tariffString = $tariffString . $value['BillingPlan']['name_bp'];
                            $tariffString = $tariffString . '</td>';
                            $tariffString = $tariffString . '<td>';
                            $tariffString = $tariffString . $value['BillingPlan']['price_bp'];
                            $tariffString = $tariffString . '</td>';
                            $tariffString = $tariffString . '</tr>';
                        }
                        $tariffString = $tariffString . '</table>';
                        $content['CmsLoginpage']['tariff'] = $tariffString;
                        $this->set('tariff', $content['CmsLoginpage']['tariff']);
                    } else {
                        $this->set('tariff', '');
                    }
                } else {
                    //$this->set('tariff', $content['CmsLoginpage']['tariff']);
                    $this->set('tariff', $content['CmsLoginpage']['tariff']);
                }
                if ($content['CmsLoginpage']['footer'] == '') {
                    $this->set('footer', '');
                } else {
                    $this->set('footer', $content['CmsLoginpage']['footer']);
                }
                if ($content['CmsLoginpage']['advertisement'] == '') {
                    $this->set('advertisement', '');
                } else {
                    $this->set('advertisement', $content['CmsLoginpage']['advertisement']);
                }
                if ($content['CmsLoginpage']['background'] == '') {
                    $this->set('background', '');
                } else {
                    $this->set('background', $content['CmsLoginpage']['background']);
                }
            }
        } else {
            $this->set('header', '');
            $this->set('tariff', '');
            $this->set('footer', '');
            $this->set('advertisement', '');
        }

        $this->Session->write('link', 'edit');
    }

    /**
     * TinyMCE editor
     * 
     * @return void
     */
    public function editor() {
        if (!$this->Acl->check(AuthComponent::user('Group.name'), $this->request->params['action']))
            $this->redirect(array('controller' => 'permission_errors', 'action' => 'unauthorized'));
        
        ////pr('hi'.$this->Session->read('choosed_location_id'));
        if ($this->request->is('post') && isset($this->request->data['CmsLoginpage']['block_title'])) {
            $this->set('login_block_title', $this->request->data['CmsLoginpage']['block_title']);
        }
        if ($this->request->is('post') && isset($this->request->data['CmsLoginpage']['block_title'])) {
            $this->set('title', $this->request->data['CmsLoginpage']['content']);
        }
        if ($this->Session->read('choosed_location_id') != '') {
            $this->set('locationId', $this->Session->read('choosed_location_id'));
            $tempLocationsDomainListArray = $this->Session->read('locations_domain_list');
            $this->set('locationDomain', $tempLocationsDomainListArray[$this->Session->read('choosed_location_id')]);
        }
        if ($this->request->is('post') && isset($this->request->data['cms_loginpages']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['cms_loginpages']['locations_id']);
            $this->set('locationId', $this->request->data['cms_loginpages']['locations_id']);
            $tempLocationsDomainListArray = $this->Session->read('locations_domain_list');
            $this->set('locationDomain', $tempLocationsDomainListArray[$this->Session->read('choosed_location_id')]);
        }
        if (count($this->request->data) == 0 && $this->Session->read('choosed_location_id') == '') {
            $this->Session->setFlash(__('Please select a location first'), 'flash_info');
        }
        if ($this->request->is('post') && isset($this->request->data['cms_loginpages']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['cms_loginpages']['locations_id']);
            if ($this->request->data['cms_loginpages']['locations_id'] == '') {
                $this->Session->setFlash(__('Please select a location first'), 'flash_info');
            }
        }
        $this->Session->write('link', 'editor');
    }

