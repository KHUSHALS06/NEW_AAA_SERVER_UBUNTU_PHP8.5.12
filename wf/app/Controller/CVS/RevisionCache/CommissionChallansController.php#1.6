    private function _exportCommissionChallanToPdf($commissionChallanData) {
        $this->set('commissionChallanData', $commissionChallanData);
        $this->layout = 'pdf'; //this will use the pdf.ctp layout
        $this->render('export_commission_challan_to_pdf');
        $this->layout = null;
        $this->autoLayout = false;
        return 0;
    }

    public function printChallan($id) {
        $this->CommissionChallan->recursive = -1;
        $challan = $this->CommissionChallan->findById($id);
        $file = $challan['CommissionChallan']['challan'];
        $size = $challan['CommissionChallan']['size'];
        $type = $challan['CommissionChallan']['type'];
        $name = $challan['CommissionChallan']['challan_name'];
        ob_clean();
        header("Content-Length: $size");
        header("Content-Type: $type");
        header("Content-Disposition:attachment;filename=$name");
        echo $file;
    }

}
