<?php

App::uses('AppController', 'Controller');

/**
 * Postpaid Login Attempt Logs Controller
 *
 * @property BillingPlan $BillingPlan
 * @property PaginatorComponent $Paginator
 */
class PostpaidLoginAttemptLogsController extends AppController {

    //public $uses = array('CheckIn', 'LocationsUser');
    public $helpers = array('Js'); //var $helpers = array('Js','Csv', 'xls', 'PhpExcel');
    public $components = array('Paginator', 'RequestHandler');

    public function index() {
        $condition = array();
        if ($this->request->is('post') && isset($this->request->data['postpaid_login_attempt_logs']['locations_id'])) {
            $this->Session->write('choosed_location_id', $this->request->data['postpaid_login_attempt_logs']['locations_id']);
        }
        if ($this->Session->check('choosed_location_id') && ($this->Session->read('choosed_location_id')!='')) {
            $condition[] = array('PostpaidLoginAttemptLog.location_id' => $this->Session->read('choosed_location_id'));
        } else {
            $condition[] = array('PostpaidLoginAttemptLog.location_id' => '');
        }
        $this->Paginator->settings = array(
                'limit' => 10,
                'order' => array('PostpaidLoginAttemptLog.created' => 'ASC'),
                'conditions' => $condition,
                //'contain' => 'BillingPlansLocation'
            );
        $this->set('label', 'Login Attempts');
        $this->set('breadcrumbLabel', 'Login Attempts');
        $this->Session->write('link', 'loginAttemptsList');
        $this->set('loginAttempts', $this->Paginator->paginate());
    }

}