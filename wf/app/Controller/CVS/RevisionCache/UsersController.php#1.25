    /**
     * Change the password of the existing user
     * 
     * @return void
     */
    public function change_password() {
        $user = $this->User->read(null, AuthComponent::user('id'));
        $this->set('user', $user);
        $hash = $this->User->generateHashChangePassword();
        $this->set('hash', $hash);

        if ($this->request->is('post')) {
# Verify if password matches
            if (($user['User']['password'] === AuthComponent::password($this->request->data['User']['current_password'])) && ($this->request->data['User']['password'] === $this->request->data['User']['re_password'])) {
# Verify if user is logged in
                if (AuthComponent::user('id')) {
                    $this->request->data['User']['id'] = AuthComponent::user('id');
                } else { # Maybe user is coming from change password form
# Check the hash in database
                    $user = $this->User->findByHashChangePassword($this->request->data['User']['hash']);

                    if (count($user) > 0) {
                        $this->request->data['User']['id'] = $user['User']['id'];

# Clean users hash in database
                        $this->request->data['User']['hash_change_password'] = '';
                    } else {
                        throw new MethodNotAllowedException(__('Invalid action'));
                    }
                }
                if ($this->User->save($this->request->data)) {
                    /* Send account creation mail to user */
                    $subject = 'Password Change';
                    $message = 'Dear ' . $user['User']['alias'] . ', \nYour password has been changed successfully. \nYour new password is ' . $this->request->data['User']['password'] . '.';
                    $this->_sendEmail($user['User']['email'], $subject, $message);

                    $this->Session->setFlash('Password updated successfully!', 'flash_success');
                    $this->redirect(array('action' => 'change_password'));
                }
            } else {
                $this->Session->setFlash('Current password is incorrect.', 'flash_fail');
            }
        }
        $this->set('breadcrumbLabel', 'Change Password');
        $this->set('label', 'Change Password');
    }

    /**
     * View the profile of the existing user
     *
     * @return void
     */
    public function profile() {
        $user = $this->User->findById(AuthComponent::user('id'));
        $user = Hash::extract($user, 'User');
        $this->User->id = $user['id'];

        if (!$this->User->exists()) {
            throw new NotFoundException(__('Invalid user'));
        }
        $this->set('user', $user);
        $this->set('breadcrumbLabel', 'My Profile');
        $this->set('label', 'My Profile');
    }

    /**
     * Inline edit the username of the user using JQuery jedittable plugin
     *
     * @return void
     */
    public function update_username() {
        if ($this->request->is('post')) {
            $data = $this->request->data;
            # Set User model for edit
            $this->User->read(null, $data['pk']);

            if ($this->User->validates(array('fieldList' => array('username')))) {
                if ($this->User->saveField($data['name'], $data['value'])) {
                    # Set the username and echo it in update_username.ctp
                    $this->User->set($data['name'], $data['value']);
                    $this->log("Username updated", 'info');
                }
            } else {
                // didn't validate logic
                $errors = $this->User->validationErrors;
            }
        }
    }

