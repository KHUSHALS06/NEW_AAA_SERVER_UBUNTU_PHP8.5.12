    /**
     * Deactivate the user
     *
     * @return void
     */
    public function deactivate($id = null) {
        if ($this->request->is('post')) {
            if ($this->request->data['User']['id'] != '') {
                $this->User->id = $this->request->data['User']['id'];
                if ($this->User->exists()) {
                    if ($this->User->saveField('status', 0)) {
                        $this->log("User deactivated", 'info');

                        $this->Session->setFlash(__('User ' . $this->request->data['User']['alias'] . ' is de-activated'), 'flash_success');
                        $this->redirect(array('action' => 'index'));
                    } else {
                        $this->Session->setFlash(__('Unable to de-activated'), 'flash_fail');
                        $this->redirect(array('action' => 'index'));
                    }
                } else {
                    $this->Session->setFlash(__('Invalid user id provided'), 'flash_fail');
                    $this->redirect(array('action' => 'index'));
                }
            } else {
                $this->Session->setFlash(__('Please provide a user id.'), 'flash_fail');
            }
        }
    }

    /**
     * Activate the user
     *
     * @return void
     */
    public function activate($id = null) {

        if ($this->request->is('post')) {
            if ($this->request->data['User']['id'] != '') {
                $this->User->id = $this->request->data['User']['id'];
                if ($this->User->exists()) {
                    if ($this->User->saveField('status', 1)) {
                        $this->log("User activated", 'info');
                        $this->Session->setFlash(__('User ' . $this->request->data['User']['alias'] . ' is activated'), 'flash_success');
                        $this->redirect(array('action' => 'index'));
                    } else {
                        $this->Session->setFlash(__('Unable to activated'), 'flash_fail');
                        $this->redirect(array('action' => 'index'));
                    }
                } else {
                    $this->Session->setFlash(__('Invalid user id provided'), 'flash_fail');
                    $this->redirect(array('action' => 'index'));
                }
            } else {
                $this->Session->setFlash(__('Please provide a user id.'), 'flash_fail');
            }
        }
    }

    /**
     * Send email to the user
     *
     * @return void
     * @access private
     */
    private function _sendEmail($to = null, $subject = null, $message = null) {
        try {
            $email = new CakeEmail('smtp');
            $email->emailFormat('both');
            //$email->from(array('abhayapatel@wifonic.com' => 'WiFonic Technologies Pvt. Ltd.'));
            if (empty($to) || $to == null) {
                $email->to('admin@wifonic.com');
            } else {
                $email->to($to);
            }
            $email->subject($subject);
            $email->send($message);
        } catch (Exception $ex) {
            //throwException($ex);
        }
    }

    public function display() {
        
    }

    function exportcvs() {
        $this->set('users', $this->User->find('all'));
        $this->layout = null;
        $this->autoLayout = false;
        Configure::write('debug', '0');
    }

    function exportxls() {
        $data = $this->User->find('all');
        $this->set('users', $data);
    }

    function viewcsv($id = null) {
        $this->set('users', $this->User->findAllById($id));
        $this->layout = null;
        $this->autoLayout = false;
        Configure::write('debug', '0');
    }

    function viewxls($id = null) {
        $data = $this->User->findAllById($id);
        $this->set('users', $data);
    }

}
